{
  "name": "trisql",
  "version": "0.1.0-alpha.1",
  "description": "2-way SQL templates as typed TypeScript queries, powered by TypeScript 7.1 content mappers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README_ja.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "esbuild": "0.28.2",
    "libpg-query": "18.1.5",
    "pg": "8.23.1",
    "typescript": "7.1.0-dev.20261019.1",
    "vite": "8.3.4"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5",
    "pg": ">=8",
    "libpg-query": ">=18"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "libpg-query": {
      "optional": true
    }
  },
  "bin": {
    "trisql": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatappo/trisql.git"
  },
  "homepage": "https://github.com/hatappo/trisql",
  "bugs": "https://github.com/hatappo/trisql/issues",
  "keywords": [
    "sql",
    "postgresql",
    "typescript",
    "2-way-sql",
    "content-mapper",
    "pglite"
  ]
}
