{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["main.ts"],
  "contentMappers": [
    { "package": "trisql-spike-mapper", "extensions": [".sql"] }
  ]
}
